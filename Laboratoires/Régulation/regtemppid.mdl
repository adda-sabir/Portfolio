  <Block BlockType="SubSystem" Name="Processus Simulé" SID="106">
    <PortCounts in="2" out="1"/>
    <P Name="Position">[1125, 182, 1330, 293]</P>
    <P Name="ZOrder">90</P>
    <P Name="BackgroundColor">cyan</P>
    <P Name="StartFcn">simu(1).bloc_Process=&apos;labo&apos;</P>
    <Mask>
      <Display/>
      <Initialization>%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

switch set_up
   case 1
        Kd = -0.64;
        T1d = 81.54;
        T2d = 18.9;
        thetad = 12.49;
   case 2
        Kd = -0.43;
        T1d = 34.66;
        T2d = 1.13;
        thetad = 6.08; 
    case 3
        Kd = -0.34;
        T1d = 82.52;
        T2d = 20.99;
        thetad = 8.42;  
end

if (demi_serie == &apos;A&apos;)
    dserie = 1;
else
    dserie = 5;
end    

seed = str2num([num2str(serie) num2str(serie) num2str(dserie) num2str(set_up)]);

rng(seed)
x1 = (rand - 1)/5;
rng(seed+1)
x2 = (rand - 1)/5;
rng(seed+2)
x3 = (rand - 1)/5;
rng(seed+3)
x4 = (rand - 1)/5;

Kd = Kd*(1+x1);
T1d = T1d*(1+x2);
T2d = T2d*(1+x3);
thetad =thetad*(1+x4);
</Initialization>
      <MaskParameter Name="set_up" Type="edit">
        <Prompt>Set_up</Prompt>
        <Value>set_up</Value>
      </MaskParameter>
      <MaskParameter Name="serie" Type="edit">
        <Prompt>Série</Prompt>
        <Value>serie</Value>
      </MaskParameter>
      <MaskParameter Name="demi_serie" Type="edit">
        <Prompt>Demi série</Prompt>
        <Value>demi_serie</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_106"/>
  </Block>
