  <Block BlockType="SubSystem" Name="Mise en forme REGUL" SID="35">
    <PortCounts/>
    <P Name="Position">[1081, 382, 1204, 410]</P>
    <P Name="ZOrder">-8</P>
    <P Name="BackgroundColor">lightBlue</P>
    <P Name="DropShadow">on</P>
    <P Name="ShowName">off</P>
    <P Name="OpenFcn">t=Scope_PID.time;               
A=[Scope_PID.signals.values];   
ysp=A(:,1);                     
u=A(:,3);                       
y=A(:,2);     
index=min(find(diff(ysp)))-99;                  
subplot(211);                   
y=y(index:end);
ysp=ysp(index:end);
t=t(index:end);
u=u(index:end);
plot(t,y,&apos;black&apos;,t,ysp,&apos;black&apos;);
grid;                           
title(&apos;PV [%] et SP [%]&apos;);         
subplot(212),                   
plot(t,u,&apos;black&apos;);              
grid;                           
figure(gcf);                    
title(&apos;MV [%]&apos;)                     </P>
    <Mask>
      <Display>disp(&apos;Mise en forme REGUL&apos;);</Display>
    </Mask>
    <System Ref="system_35"/>
  </Block>
