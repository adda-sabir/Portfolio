  <Block BlockType="SubSystem" Name="Mise en forme IDENT" SID="32">
    <PortCounts/>
    <P Name="Position">[909, 382, 1031, 410]</P>
    <P Name="ZOrder">-5</P>
    <P Name="BackgroundColor">lightBlue</P>
    <P Name="DropShadow">on</P>
    <P Name="ShowName">off</P>
    <P Name="OpenFcn">t=Scope_PID.time;A=[Scope_PID.signals.values];
y=A(:,2);u=A(:,3);
subplot(211)
plot(t,u,&apos;black&apos;);
title(&apos;MV [%]&apos;)
subplot(212)
plot(t,y,&apos;black&apos;);
title(&apos;PV [%]&apos;)
grid;figure(gcf)   
                              
                              
                              
tstep=find(diff(u)~=0);       
tstep=tstep(end); % take last change

tm=t(tstep:end);              
tm=tm-t(tstep);               
um=u(tstep:end);              
um=um-um(1);                  
ym=y(tstep:end);              
ym=ym-ym(1);                  

y0 = y(tstep);
du = u(end)-u(tstep);</P>
    <Mask>
      <Display>disp(&apos;Mise en forme IDENT&apos;)</Display>
    </Mask>
    <System Ref="system_32"/>
  </Block>
  <Block BlockType="SubSystem" Name="Mise en forme IDENT1" SID="85">
    <PortCounts/>
    <P Name="Position">[689, 338, 844, 374]</P>
    <P Name="ZOrder">89</P>
    <P Name="DropShadow">on</P>
    <P Name="ShowName">off</P>
    <P Name="OpenFcn">string_PID = get_param(bdroot, &apos;Name&apos;);

AMbit=3-length(get_param([string_PID &apos;/Pid serie&apos;],&apos;AMbit&apos;));
                                                             
if AMbit==1,                                                 
set_param([string_PID &apos;/Pid serie&apos;],&apos;AMbit&apos;,&apos;off&apos;);          
AMbit=0;                                                     
elseif AMbit==0,                                             
set_param([string_PID &apos;/Pid serie&apos;],&apos;AMbit&apos;,&apos;on&apos;);           
AMbit=1;                                                     
end                                                          
                                                             
                                                             
if AMbit==1,                                                 
	set_param([string_PID &apos;/Pid serie&apos;],&apos;BackgroundColor&apos;,&apos;red&apos;);                                  
	set_param([string_PID &apos;/Pid serie&apos;],&apos;MaskDisplay&apos;,&apos;disp(&apos;&apos;  PID \n [AUTO]&apos;&apos;)&apos;);
end             
if AMbit==0,                                                 
	set_param([string_PID &apos;/Pid serie&apos;],&apos;BackgroundColor&apos;,&apos;lightblue&apos;);                            
	set_param([string_PID &apos;/Pid serie&apos;],&apos;MaskDisplay&apos;,&apos;disp(&apos;&apos;  PID \n [MANU]&apos;&apos;)&apos;);                
end                                                          </P>
    <P Name="FontName">Arial</P>
    <P Name="FontSize">12</P>
    <P Name="FontWeight">bold</P>
    <Mask>
      <Display>disp(&apos;Manu &lt;-&gt;Auto&apos;)</Display>
    </Mask>
    <System Ref="system_85"/>
  </Block>
  <Block BlockType="SubSystem" Name="Mise en forme IDENT2" SID="34">
