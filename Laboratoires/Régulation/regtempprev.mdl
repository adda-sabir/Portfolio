      OpenFcn		      "string_PID = get_param(bdroot, 'Name');\n\nAMbit=3-length(get_param([string_PID '/Pid serie'],'A"
      "Mbit'));\n                                                             \nif AMbit==1,                           "
      "                      \nset_param([string_PID '/Pid serie'],'AMbit','off');          \nAMbit=0;                 "
      "                                    \nelseif AMbit==0,                                             \nset_param(["
      "string_PID '/Pid serie'],'AMbit','on');           \nAMbit=1;                                                    "
      " \nend                                                          \n                                              "
      "               \n                                                             \nif AMbit==1,                    "
      "                             \n	set_param([string_PID '/Pid serie'],'BackgroundColor','red');                   "
      "               \n	set_param([string_PID '/Pid serie'],'MaskDisplay','disp(''  PID \\n [AUTO]'')');\nend         "
      "    \nif AMbit==0,                                                 \n	set_param([string_PID '/Pid serie'],'Backg"
      "roundColor','lightblue');                            \n	set_param([string_PID '/Pid serie'],'MaskDisplay','disp("
      "''  PID \\n [MANU]'')');                \nend                                                          "
      FontName		      "Arial"
      FontSize		      12
      FontWeight	      "bold"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		23
	$ClassName		"Simulink.Mask"
	Display			"disp('Manu <->Auto')"
      }
