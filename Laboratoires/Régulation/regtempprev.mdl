	$ObjectID		34
	$ClassName		"Simulink.Mask"
	Initialization		"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n\nswitch set_up\n   case 1\n        Kd = -0.64;\n        T1d = 81"
	".54;\n        T2d = 18.9;\n        thetad = 12.49;\n   case 2\n        Kd = -0.43;\n        T1d = 34.66;\n        T2d"
	" = 1.13;\n        thetad = 6.08; \n    case 3\n        Kd = -0.34;\n        T1d = 82.52;\n        T2d = 20.99;\n     "
	"   thetad = 8.42;  \nend\n\nif (demi_serie == 'A')\n    dserie = 1;\nelse\n    dserie = 5;\nend    \n\nseed = str2num"
	"([num2str(serie) num2str(serie) num2str(dserie) num2str(set_up)]);\n\nrng(seed)\nx1 = (rand - 1)/5;\nrng(seed+1)\nx2 "
	"= (rand - 1)/5;\nrng(seed+2)\nx3 = (rand - 1)/5;\nrng(seed+3)\nx4 = (rand - 1)/5;\n\nKd = Kd*(1+x1);\nT1d = T1d*(1+x2"
	");\nT2d = T2d*(1+x3);\nthetad =thetad*(1+x4);\n"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  3
	  Object {
	    $ObjectID		    35
	    Type		    "edit"
	    Name		    "set_up"
	    Prompt		    "Set_up"
	    Value		    "set_up"
	  }
	  Object {
	    $ObjectID		    36
	    Type		    "edit"
	    Name		    "serie"
	    Prompt		    "Série"
	    Value		    "serie"
	  }
	  Object {
	    $ObjectID		    37
	    Type		    "edit"
	    Name		    "demi_serie"
	    Prompt		    "Demi série"
	    Value		    "demi_serie"
	  }
	  PropName		  "Parameters"
	}
      }
